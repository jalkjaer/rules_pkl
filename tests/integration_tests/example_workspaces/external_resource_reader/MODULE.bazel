bazel_dep(name = "rules_pkl", version = "1.0")
local_path_override(
    module_name = "rules_pkl",
    path = "../../../..",
)

bazel_dep(name = "reader_module", version = "0.0.0")
local_path_override(
    module_name = "reader_module",
    path = "reader_module",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.21.2")

# rules_go must be >= 0.59.0: that is the first release whose cgo.bzl and
# cross.bzl load CcInfo from @rules_cc//cc/common:cc_info.bzl instead of relying
# on the legacy global symbol, which Bazel 9 + rules_cc 0.2.x no longer provide.
bazel_dep(name = "rules_go", version = "0.59.0")
bazel_dep(name = "gazelle", version = "0.51.0")

pkl = use_extension("@rules_pkl//pkl/extensions:pkl.bzl", "pkl")

# Register the PklProject together with the external resource reader mapping.
# This generates @echo_reader_project//:packages (a pkl_cache) that carries both
# the PklProject and the reader mapping into any pkl_eval that depends on it —
# no manual pkl_project_rule / pkl_cache targets needed in BUILD.bazel.
pkl.project(
    name = "echo_reader_project",
    external_resource_readers = {
        "//:echo_reader": "reader+echo",
        "//:echo_reader_plain": "reader+echofile",
        "//:echo_data_reader": "reader+echodata",
        "@reader_module//:ext_reader": "reader+echoext",
    },
    pkl_project = "//:PklProject",
    pkl_project_deps = "//:PklProject.deps.json",
)
use_repo(
    pkl,
    "echo_reader_project",
    "pkl-cli-linux-aarch64",
    "pkl-cli-linux-amd64",
    "pkl-cli-macos-aarch64",
    "pkl-cli-macos-amd64",
    "pkl-doc-cli-linux-aarch64",
    "pkl-doc-cli-linux-amd64",
    "pkl-doc-cli-macos-aarch64",
    "pkl-doc-cli-macos-amd64",
)

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_apple_pkl_go",
)
