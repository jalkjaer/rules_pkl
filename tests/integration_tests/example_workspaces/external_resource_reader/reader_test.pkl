/// pkl_test for the external resource reader.
/// Verifies that the reader+echo and reader+echofile schemes work in a test target.

amends "pkl:test"

facts {
  ["reader+echo scheme returns URI opaque as content"] {
    read("reader+echo:hello-from-test").text.trim() == "hello-from-test"
  }
  ["reader+echofile scheme returns URI opaque as content"] {
    read("reader+echofile:hello-from-file-test").text.trim() == "hello-from-file-test"
  }
  ["reader+echoext (external-repo reader) returns URI opaque as content"] {
    read("reader+echoext:hello-from-ext-repo").text.trim() == "hello-from-ext-repo"
  }
}
