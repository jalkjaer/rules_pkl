amends "pkl:Project"

// This project deliberately has no dependencies, so its pkl_cache has no items.
// That covers the empty-cache case: on Bazel 7.6.1 and 8.7.0 an empty cache
// directory used to be dropped from the sandboxed pkl_test (reader_test)
// runfiles. pkl_cache now writes a marker file to keep the directory non-empty.

// Declare the external resource reader so that the "reader+echo:" scheme is
// known to Pkl. For non-Bazel consumers of a published package, `executable`
// must be resolvable on PATH. For Bazel builds, the
// `--external-resource-reader reader+echo=<bazel-built-path>` flag (injected
// automatically by the pkl_cache in deps) overrides this executable.
evaluatorSettings {
  externalResourceReaders {
    ["reader+echo"] {
      // The executable name below does not exist on PATH. Bazel-built readers
      // override this via the --external-resource-reader flag. If that flag
      // were absent, Pkl would fail trying to exec this non-existent binary.
      executable = "does-not-exist-echo_reader"
    }
    ["reader+echofile"] {
      executable = "does-not-exist-echo_reader"
    }
    ["reader+echowrapped"] {
      executable = "does-not-exist-echo_reader_wrapper"
    }
    ["reader+echoext"] {
      executable = "does-not-exist-ext_reader"
    }
  }
}
