load("@rules_go//go:def.bzl", "go_binary")

# External-repo reader for the "reader+echoext" scheme.
# This target lives in the reader_module repo (@@reader_module+//:ext_reader),
# which is wired into the workspace via bazel_dep + local_path_override.
# Its short_path starts with "../reader_module+/", which pkl_test passes
# unchanged: the test runs with its cwd inside the runfiles tree, so a "../"
# path resolves to the sibling external-repo directory without any rewriting.
go_binary(
    name = "ext_reader",
    srcs = ["ext_reader.go"],
    visibility = ["//visibility:public"],
    deps = ["@com_github_apple_pkl_go//pkl"],
    pure = "on",
)
