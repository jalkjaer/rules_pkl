load("@aspect_bazel_lib//lib:diff_test.bzl", "diff_test")
load("@rules_go//go:def.bzl", "go_binary")
load("@rules_pkl//pkl:defs.bzl", "pkl_eval", "pkl_test")

# Example external resource reader for the "reader+echo:" scheme.
# go_binary produces a statically-linked native binary that needs no runfiles
# or interpreter to start.
#
# The reader is wired to the PklProject entirely in MODULE.bazel via
# pkl.project(external_resource_readers = {...}). The generated
# @echo_reader_project//:packages target carries the reader mapping into the
# pkl_eval below — no pkl_project_rule / pkl_cache needed here.
go_binary(
    name = "echo_reader",
    srcs = ["echo_reader.go"],
    pure = "on",
    visibility = ["//visibility:public"],
    deps = ["@com_github_apple_pkl_go//pkl"],
)

# A plain-file copy of echo_reader, registered under "reader+echofile".
# This exercises the non-executable (plain-file) code path in pkl_project_rule:
# files_to_run.executable is None, so the file is passed as an input rather
# than a tool.  The chmod +x ensures pkl can exec the file as a subprocess.
genrule(
    name = "echo_reader_plain",
    srcs = [":echo_reader"],
    outs = ["echo_reader_plain_out"],
    cmd = "cp $(location :echo_reader) $@ && chmod +x $@",
    visibility = ["//visibility:public"],
)

# A reader with a data dependency: echo_data_reader reads reader_prefix.txt from
# its runfiles (rules_go runfiles library) and prepends the content to every
# resource it returns, so the result is only correct if the reader's runfiles
# were staged. Registered under "reader+echodata".
#
# - pkl_eval: the reader is an action tool, so its own <exe>.runfiles tree is
#   staged next to it.
# - pkl_test: the reader's runfiles are merged into the test's runfiles.
go_binary(
    name = "echo_data_reader",
    srcs = ["echo_data_reader.go"],
    data = [":reader_prefix.txt"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_apple_pkl_go//pkl",
        "@rules_go//go/runfiles",
    ],
)

pkl_eval(
    name = "example",
    srcs = ["example.pkl"],
    format = "yaml",
    deps = ["@echo_reader_project//:packages"],
)

pkl_eval(
    name = "example_data",
    srcs = ["data.pkl"],
    format = "yaml",
    deps = ["@echo_reader_project//:packages"],
)

pkl_test(
    name = "reader_test",
    srcs = ["reader_test.pkl"],
    deps = ["@echo_reader_project//:packages"],
)

diff_test(
    name = "example_diff_test",
    file1 = "expected_output.yaml",
    file2 = ":example",
)

diff_test(
    name = "example_data_diff_test",
    file1 = "expected_data.yaml",
    file2 = ":example_data",
)
